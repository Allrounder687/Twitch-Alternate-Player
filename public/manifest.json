{
  "manifest_version": 3,
  "name": "Twitch Player Extension",
  "version": "2.0.0",
  "description": "An alternative player for Twitch.tv with enhanced features",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://usher.ttvnw.net/*",
    "https://*.ttvnw.net/*",
    "https://*.live-video.net/*",
    "https://*.akamaized.net/*",
    "https://*.cloudfront.net/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "wss://irc-ws.chat.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Twitch Player"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.twitch.tv/*"]
    }
  ]
}
